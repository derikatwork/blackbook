#---------------------------------------------
# Blackbook tint2 panel
# BunsenLabs-style dark bottom panel:
#   launcher | taskbar | systray | clock | power button
# See 'man tint2' for all options.
#---------------------------------------------

#-------------------------------------
# Backgrounds
# Background 1: Panel
rounded = 0
border_width = 0
background_color = #1a1a1a 90
border_color = #000000 0

# Background 2: Active task
rounded = 0
border_width = 0
background_color = #3a3a3a 100
border_color = #5d8185 0

# Background 3: Inactive task
rounded = 0
border_width = 0
background_color = #1a1a1a 0
border_color = #000000 0

# Background 4: Urgent task
rounded = 0
border_width = 1
background_color = #888888 20
border_color = #ed2323 60

# Background 5: Tooltip
rounded = 1
border_width = 1
background_color = #2c2c2c 100
border_color = #232323 100

#-------------------------------------
# Panel
panel_items = LTSCP
panel_size = 100% 30
panel_margin = 0 0
panel_padding = 4 0 4
panel_background_id = 1
wm_menu = 1
panel_dock = 0
panel_position = bottom center horizontal
panel_layer = bottom
panel_monitor = all
strut_policy = follow_size
panel_window_name = tint2
disable_transparency = 0
mouse_effects = 1
font_shadow = 0
scale_relative_to_dpi = 0
scale_relative_to_screen_height = 0

#-------------------------------------
# Launcher - Panel item = L
launcher_padding = 6 4 6
launcher_background_id = 0
launcher_icon_background_id = 0
launcher_icon_size = 22
launcher_icon_asb = 100 0 0
launcher_icon_theme = Papirus-Dark
launcher_icon_theme_override = 1
startup_notifications = 1
launcher_tooltip = 1
launcher_item_app = /var/lib/flatpak/exports/share/applications/app.zen_browser.zen.desktop
launcher_item_app = /run/current-system/sw/share/applications/thunar.desktop
launcher_item_app = /run/current-system/sw/share/applications/xfce4-terminal.desktop
launcher_item_app = /run/current-system/sw/share/applications/geany.desktop

#-------------------------------------
# Taskbar - Panel item = T
taskbar_mode = multi_desktop
taskbar_hide_if_empty = 0
taskbar_padding = 2 0 4
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 0
taskbar_distribute_size = 0
taskbar_sort_order = none
task_align = left

#-------------------------------------
# Task
task_text = 1
task_icon = 1
task_centered = 0
task_maximum_size = 180 30
task_padding = 6 2 6
task_font = Sans 9
task_tooltip = 1
task_font_color = #cccccc 80
task_active_font_color = #ffffff 100
task_urgent_font_color = #ffffff 100
task_iconified_font_color = #999999 80
task_background_id = 3
task_active_background_id = 2
task_urgent_background_id = 4
task_iconified_background_id = 3
mouse_left = toggle_iconify
mouse_middle = none
mouse_right = close
mouse_scroll_up = toggle
mouse_scroll_down = iconify

#-------------------------------------
# System tray (notification area) - Panel item = S
systray_padding = 2 2 2
systray_background_id = 0
systray_sort = right2left
systray_icon_size = 20
systray_icon_asb = 100 0 0
systray_monitor = primary

#-------------------------------------
# Clock - Panel item = C
time1_format = %H:%M
time1_font = Sans bold 11
time2_format = %a %d %b
time2_font = Sans 8
clock_font_color = #ececec 100
clock_padding = 8 0 8
clock_background_id = 0
clock_tooltip = %A %d %B %Y
clock_lclick_command = gsimplecal

#-------------------------------------
# Button - Panel item = P (power / logout)
button = new
button_icon = system-shutdown
button_text =
button_tooltip = Log Out / Shutdown
button_lclick_command = blackbook-exit
button_padding = 8 4
button_background_id = 0
button_centered = 1
button_max_icon_size = 20

#-------------------------------------
# Tooltip
tooltip_show_timeout = 0.4
tooltip_hide_timeout = 0.2
tooltip_padding = 6 4
tooltip_background_id = 5
tooltip_font_color = #f7f7f7 100
tooltip_font = Sans 9
