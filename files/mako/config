# Notification settings. Installed as /etc/xdg/mako/config.
# mako does not look in /etc/xdg by itself; the `start-mako` helper passes
# this file unless you have your own ~/.config/mako/config. See `man 5 mako`.

font=Noto Sans 12
anchor=bottom-right
outer-margin=0,8,8,0
width=360
padding=10
border-size=2
border-radius=8
background-color=#ffffff
text-color=#241f31
border-color=#3584e4
max-visible=4
icons=1
max-icon-size=48

# Hide each notification after 5 seconds.
default-timeout=5000

[urgency=critical]
border-color=#c01c28
