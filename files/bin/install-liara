#!/usr/bin/env bash
# Install NixOS on this Chromebook from the live USB (README, section 7).
# Downloads the newest version of this repo from GitHub (or updates the copy
# downloaded before, keeping your edits), asks which disk to use, then runs the
# repo's scripts/install.sh, which shows the disks again and asks you to type
# the disk name before it erases anything.
# @repoUrl@ is replaced with the repo's address when the live USB is built.
set -euo pipefail

REPO_URL="@repoUrl@"
REPO_DIR="$HOME/blackbook"

step() { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }
die() {
  printf '\n\033[1;31mERROR: %s\033[0m\n' "$*" >&2
  exit 1
}

step "Checking the internet connection"
until curl --silent --fail --head --max-time 15 https://github.com >/dev/null; do
  echo "    Can't reach github.com. Connect to Wi-Fi with the Wi-Fi icon at"
  echo "    the bottom right of the screen, then press Enter to try again."
  echo "    (Ctrl+C stops.)"
  read -r _
done

if [ -d "$REPO_DIR/.git" ]; then
  step "Updating the repo in $REPO_DIR"
  git -C "$REPO_DIR" pull --ff-only ||
    die "Could not update $REPO_DIR (see above). To start over with a fresh copy: rm -rf $REPO_DIR"
else
  step "Downloading the repo to $REPO_DIR"
  git clone --depth 1 "$REPO_URL" "$REPO_DIR"
fi

step "Disks in this computer"
lsblk -e 7 -o NAME,SIZE,MODEL,TRAN,RM
cat <<'EOF'

    The internal disk is usually mmcblk0: its TRAN is empty or "mmc",
    and RM is 0. The USB stick you started from shows TRAN "usb".
    Ignore mmcblk0boot0, mmcblk0boot1 and mmcblk0rpmb (small hidden
    areas of the same chip).

EOF
read -r -p "Disk to install NixOS on (for example /dev/mmcblk0): " disk
[ -n "$disk" ] || die "No disk given; nothing was changed."
case "$disk" in
  /*) ;;
  *) disk="/dev/$disk" ;;
esac

sudo bash "$REPO_DIR/scripts/install.sh" "$disk"
