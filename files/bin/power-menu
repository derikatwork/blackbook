#!/usr/bin/env bash
# Power menu for the panel's ⏻ button: Lock, Suspend, Log out, Reboot, Shut down.

choice=$(printf '%s\n' "Lock" "Suspend" "Log out" "Reboot" "Shut down" |
  fuzzel --dmenu --prompt "Power: " --lines 5 --width 18) || exit 0

case "$choice" in
  "Lock") exec lock-screen ;;
  "Suspend") exec systemctl suspend ;;
  "Log out") exec labwc --exit ;;
  "Reboot") exec systemctl reboot ;;
  "Shut down") exec systemctl poweroff ;;
esac
