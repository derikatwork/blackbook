<?xml version="1.0" encoding="UTF-8"?>
<!-- The menu shown when you right-click the desktop background.
     Installed as /etc/xdg/labwc/menu.xml. See `man labwc-menu`. -->
<openbox_menu>
  <menu id="root-menu" label="">
    <item label="Terminal"><action name="Execute" command="foot"/></item>
    <item label="Firefox"><action name="Execute" command="firefox"/></item>
    <item label="Thunderbird"><action name="Execute" command="thunderbird"/></item>
    <item label="Files"><action name="Execute" command="thunar"/></item>
    <separator/>
    <item label="Wi-Fi"><action name="Execute" command="nm-connection-editor"/></item>
    <item label="Bluetooth"><action name="Execute" command="blueman-manager"/></item>
    <item label="Sound"><action name="Execute" command="pavucontrol"/></item>
    <separator/>
    <item label="Lock"><action name="Execute" command="lock-screen"/></item>
    <item label="Log out"><action name="Exit"/></item>
    <item label="Reboot"><action name="Execute" command="systemctl reboot"/></item>
    <item label="Shut down"><action name="Execute" command="systemctl poweroff"/></item>
  </menu>
</openbox_menu>
